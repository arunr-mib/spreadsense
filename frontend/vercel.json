  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://spreadsense-production.up.railway.app/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://spreadsense-production.up.railway.app/:path*"
    }
